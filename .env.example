DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional — the same database's *unpooled* connection (Neon: same host
# minus "-pooler"). Only used by prisma.config.ts, which only the Prisma CLI
# (generate/migrate/studio) reads — falls back to DATABASE_URL above if
# unset, so this is safe to leave blank for a quick local setup. Strongly
# recommended in any environment that runs `prisma migrate deploy`, though:
# Prisma Migrate's advisory-lock-based locking is session-scoped and doesn't
# reliably work through a pooled (PgBouncer-style) connection, which caused
# repeated P1002 "timed out trying to acquire a postgres advisory lock"
# build failures in Production. Neon's own dashboard/Vercel integration
# provides this as DATABASE_URL_UNPOOLED automatically.
DATABASE_URL_UNPOOLED=

# better-auth (docs/36) — generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Sends password-reset emails via Gmail SMTP + an app password (Gmail
# Settings -> Security -> 2-Step Verification -> App passwords). Not your
# normal Gmail password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Authenticates Vercel Cron's daily call to /api/cron/purge-rate-limits
# (vercel.json) — Vercel sends this as `Authorization: Bearer <value>`
# automatically once the env var is set on the project; generate the same
# way as BETTER_AUTH_SECRET above. Not required for local dev (the route
# just 401s without it, which is correct — nothing local should be purging
# rate-limit rows on a schedule).
CRON_SECRET=
