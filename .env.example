DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# better-auth (docs/36) — generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Sends password-reset emails via Gmail SMTP + an app password (Gmail
# Settings -> Security -> 2-Step Verification -> App passwords). Not your
# normal Gmail password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Authenticates Vercel Cron's daily call to /api/cron/purge-rate-limits
# (vercel.json) — Vercel sends this as `Authorization: Bearer <value>`
# automatically once the env var is set on the project; generate the same
# way as BETTER_AUTH_SECRET above. Not required for local dev (the route
# just 401s without it, which is correct — nothing local should be purging
# rate-limit rows on a schedule).
CRON_SECRET=
