DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# better-auth (docs/36) — generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Sends password-reset emails via Gmail SMTP + an app password (Gmail
# Settings -> Security -> 2-Step Verification -> App passwords). Not your
# normal Gmail password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
