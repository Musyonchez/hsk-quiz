# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# database
/prisma/dev.db
/dev.db

# Prisma-vendored AI-agent reference docs (auto-installed by `prisma init`,
# not authored here — regenerate with `npx prisma init` if ever needed)
/.agents
/.claude
/.windsurf
/skills-lock.json

# Playwright MCP's default screenshot/snapshot output dir — must never land
# here during `npm run dev`: the dev server's file watcher treats any new
# file here as a change and fires a Fast Refresh rebuild, which remounts
# client components and silently resets their local state (found the hard
# way testing docs/28's Hard mode toggle). Always pass an absolute
# out-of-repo path to browser_take_screenshot/browser_snapshot instead of
# relying on this being ignored — gitignore doesn't stop the watcher, it
# only stops the files from being committed if one slips through.
/.playwright-mcp
