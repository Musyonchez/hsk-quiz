// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Level {
  id       Int       @id @default(autoincrement())
  slug     String    @unique // "1" | "2" | "3" | "4a" | "4b" | "5a" | "5b" | "6a" | "6b"
  number   Int // 1 | 2 | 3 | 4 | 5 | 6 — shared by a level's A/B book pair, no longer unique
  part     String? // "A" | "B" | null (levels 1-3 have no book split)
  name     String // "HSK 1" | "HSK 4A"
  chapters Chapter[]
  words    Word[]
}

model Chapter {
  id              Int              @id @default(autoincrement())
  levelId         Int
  level           Level            @relation(fields: [levelId], references: [id])
  number          Int
  title           String
  words           Word[]
  grammarPatterns GrammarPattern[]
  dialogLines     DialogLine[]

  @@unique([levelId, number])
}

model Word {
  id        Int      @id @default(autoincrement())
  levelId   Int
  level     Level    @relation(fields: [levelId], references: [id])
  chapterId Int? // null for combined-only words
  chapter   Chapter? @relation(fields: [chapterId], references: [id])
  chinese   String
  pinyin    String
  wordType  String? // "n." | "v." | ... (chapter source) — nullable for combined rows
  meaning   String?
  category  String? // PDF word-class, e.g. "Personal Pron." (combined source only)
  source    String // "chapter" | "combined" | "dialog"
  // Character mode's popup mnemonic (docs/38, docs/39) — null until written.
  // Keyed conceptually by `chinese` text, not by row: the same word can span
  // several rows (chapter/combined/dialog, across levels once "combined" is
  // cumulative), and they all share one mnemonic rather than each needing
  // its own — the backfill script in docs/39 sets every row with matching
  // `chinese` in one pass, not just the row it was authored against.
  mnemonic  String?

  // `source` is part of the key (not just [chapterId, chinese]) because a
  // word can legitimately have two rows for the same chapterId: a "chapter"
  // row (curated New Words) and a "dialog" row (docs/25-chapter-all-words-
  // plan.md's full, independently-ordered dialog vocabulary) — the same
  // word really does appear in both the textbook's New Words box and its
  // dialog text, and All Words intentionally isn't deduplicated against
  // New Words (see docs/25's "What All Words means here").
  @@unique([chapterId, chinese, source])
}

// A chapter's actual dialog transcript — docs/hold/25-chapter-all-words-plan.md's
// addendum. Genuinely different shape from Word (a full sentence with a
// speaker and an English translation, not a single vocabulary entry), so
// its own model rather than overloading Word again. `order` is absolute
// across the whole chapter (spans every dialogNumber) so the transcript
// page can render everything in one straightforward orderBy without also
// needing a secondary sort key.
model DialogLine {
  id           Int     @id @default(autoincrement())
  chapterId    Int
  chapter      Chapter @relation(fields: [chapterId], references: [id])
  order        Int
  dialogNumber Int // which "Dialog N" scene this line belongs to
  dialogLabel  String? // e.g. "In the classroom" — same for every line in that scene
  speaker      String // "A" | "B" | a named character, e.g. "小丽" | "妈妈"
  chinese      String
  pinyin       String
  english      String

  @@unique([chapterId, order])
}

model GrammarPattern {
  id              Int     @id @default(autoincrement())
  chapterId       Int
  chapter         Chapter @relation(fields: [chapterId], references: [id])
  label           String
  pinyinSkeleton  String
  note            String?
}

// Auth moved to self-hosted better-auth (docs/36) — User/Session/Account/
// Verification below follow better-auth's own schema exactly (confirmed
// directly against the installed version's @better-auth/core/db/
// get-tables.mjs, not just its docs, which lag the actual API). `id` stays
// Int/autoincrement (`advanced.database.generateId: "serial"` in
// src/lib/auth.ts) so Friendship/Attempt's existing Int foreign keys don't
// need to change. `displayName` is the real column name for what
// better-auth's own API calls `.name` (`user.fields.name: "displayName"` in
// src/lib/auth.ts) — every query elsewhere in this app keeps reading
// `displayName` unchanged.
model User {
  id              Int          @id @default(autoincrement())
  username        String?      @unique
  displayUsername String? // as-typed casing; `username` itself is lowercased by the plugin
  displayName     String
  email           String       @unique
  emailVerified   Boolean      @default(false)
  image           String? // better-auth core field, unused by this app's UI
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  sessions        Session[]
  accounts        Account[]
  attempts        Attempt[]
  sentRequests    Friendship[] @relation("FriendshipSender")
  recvRequests    Friendship[] @relation("FriendshipReceiver")
}

model Session {
  id        Int      @id @default(autoincrement())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Credential storage (password hash lives here, not on User) — also where
// future OAuth accounts would attach, though none are wired up (docs/36
// explicitly ruled out OAuth for this migration).
model Account {
  id                    Int       @id @default(autoincrement())
  accountId             String
  providerId            String
  userId                Int
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

// Reset-password (and any future email-verification) tokens.
model Verification {
  id         Int      @id @default(autoincrement())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// A minimal key/value store passed to better-auth as `secondaryStorage`
// (src/lib/rate-limit-storage.ts) — scoped to exactly one job, durable
// login/reset-password rate-limit counters, since Session/Verification are
// explicitly forced back into their own tables above (see the comment in
// src/lib/auth.ts). Replaces the old LoginFailure table + login-rate-
// limit.ts with the equivalent durable-across-serverless-invocations
// property (docs/hold/22-audit-pass-4.md), now backed by the library
// instead of custom lockout logic.
model RateLimit {
  id        Int       @id @default(autoincrement())
  key       String    @unique
  value     String
  expiresAt DateTime?
}

model Friendship {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation("FriendshipSender", fields: [userId], references: [id])
  friendId  Int
  friend    User     @relation("FriendshipReceiver", fields: [friendId], references: [id])
  status    String // "pending" | "accepted" | "ignored"
  createdAt DateTime @default(now())

  @@unique([userId, friendId])
}

model Attempt {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id])
  quizKey         String // "hsk1-chapter5" | "hsk1-combined" | ...
  score           Int
  total           Int
  durationSeconds Int
  createdAt       DateTime @default(now())

  @@index([userId, quizKey])
}
